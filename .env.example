# ============================================================
# fiveagents — תבנית משתני סביבה
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# אל תעלה את .env ל-git! (הוא כבר ב-.gitignore)
# ============================================================

# --- כללי / ראובן (המנכ"ל) ---
# מפתח ה-API של Anthropic לשימוש הצוות
ANTHROPIC_API_KEY=

# --- חן (החוקרת) — חיפוש ואיסוף מידע ---
# מפתח API לשירות חיפוש (לדוגמה: Tavily / Serper / Brave)
SEARCH_API_KEY=

# --- יובל (מעצב התמונות) — הפקת תמונות ---
# מפתח API לשירות יצירת תמונות (לדוגמה: OpenAI / Stability)
IMAGE_API_KEY=
# מפתח OpenAI ליצירת תמונות דרך הסקיל gpt-image-gen (מודל gpt-image-2)
OPENAI_API_KEY=

# --- הגדרות כלליות ---
# סביבת הרצה: development / production
APP_ENV=development
# רמת לוגים: debug / info / warn / error
LOG_LEVEL=info
